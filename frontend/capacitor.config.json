{
  "appId": "com.itgenic.app",
  "appName": "dailyIT",
  "webDir": "dist",
  "server": {
    "iosScheme": "https",
    "androidScheme": "https",
    "hostname": "localhost"
  },
  "plugins": {
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": false
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#1a56db",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "overlaysWebView": true
    },
    "SystemBars": {
      "insetsHandling": "disable"
    }
  }
}
